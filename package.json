{
  "name": "iobroker.snmp",
  "version": "4.0.0",
  "description": "ioBroker SNMP Adapter",
  "author": "Marcolotti <info@ct-j.de>",
  "contributors": [
    "Marcolotti <info@ct-j.de>",
    "McM1957 <mcm57@gmx.at>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.snmp",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "snmp",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iobroker-community-adapters/ioBroker.snmp.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "net-snmp": "^3.29.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@iobroker/types": "^7.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build-backend": "tsc -p tsconfig.build.json",
    "build": "npm run build-backend && tsx tasks.ts",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "check-tasks": "tsc -p tsconfig.tasks.json",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:unit": "npm run build-backend && mocha --require tsx/cjs test/mibStore test/mibBrowser test/snmpSession test/templates test/trapReceiver test/utils test/varbind --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package && npm run test:unit",
    "release": "release-script",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "update-packages": "npx npm-check-updates --upgrade",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-build": "tsx tasks.ts --2-build",
    "3-copy": "tsx tasks.ts --3-copy",
    "npm": "npm i && cd src-admin && npm i"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.snmp/issues"
  }
}
